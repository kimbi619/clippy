BRIDGE_API_KEY=change-me-in-production
BACKEND_URL=http://localhost:8000

# E.164 number the bot is registered on (used for logging only in Milestone 1)
WHATSAPP_PHONE=+1234567890

# Path to the whatsmeow SQLite session file. Treat this file as a credential.
STORE_PATH=whatsmeow.db

# Comma-separated E.164 numbers allowed to add the bot to a call
ALLOWED_NUMBERS=+1234567890,+0987654321

ASSEMBLYAI_KEY=
ANTHROPIC_KEY=
LOG_LEVEL=info
